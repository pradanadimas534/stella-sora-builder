# Copy to .env (never commit secrets). Node loads this file via --env-file-if-exists.
PORT=4317
HOST=127.0.0.1
AUTO_SYNC=true
SYNC_INTERVAL_HOURS=6

# Optional discovery adapters. Leave empty to show not-configured status.
YOUTUBE_API_KEY=
# Google Custom Search: existing customers only; migration required before 2027-01-01.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Add Page IDs to data/sources.json and select a supported Graph API version.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=
